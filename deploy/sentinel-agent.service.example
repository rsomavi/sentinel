[Unit]
Description=Sentinel SSH monitoring agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/sentinel/src
ExecStart=/path/to/sentinel/venv/bin/python3 manage.py monitor_server /var/log/auth.log "Your Server Name"
Restart=on-failure
User=your_username

[Install]
WantedBy=multi-user.target
